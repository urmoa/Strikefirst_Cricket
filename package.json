{
  "name": "strike-first-draft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-db.cjs",
    "db:check": "node scripts/check-db.cjs",
    "db:verify": "node scripts/verify-db.cjs",
    "db:setup:neon": "node scripts/setup-neon.cjs",
    "db:verify:neon": "node scripts/verify-neon.cjs"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.9",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.0"
  }
}
